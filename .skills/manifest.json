{
  "manifest_version": "1.1",
  "capabilities": {
    "processing": { "path": ".skills/processing/", "allowed_extensions": [".py", ".sql"] },
    "capture": { "path": ".skills/capture/", "allowed_extensions": [".py", ".sh"] },
    "persistence": { "path": ".skills/persistence/", "allowed_extensions": [".py"] }
  },
  "guardrails": {
    "strict_mode": true,
    "allowed_target_tables": [
      "photos",
      "spatial_cache",
      "control_operaciones"
    ]
  }
}
